{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "run-prompts": {
      "path": "/api/cron/run-prompts",
      "schedule": "0 8,12,16,20 * * *",
      "timezone": "UTC",
      "requestMethod": "GET"
    },
    "compute-scores": {
      "path": "/api/cron/compute-scores",
      "schedule": "30 20 * * *",
      "timezone": "UTC",
      "requestMethod": "GET"
    }
  }
}
